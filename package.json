{
  "name": "kancl",
  "version": "0.1.0",
  "private": true,
  "description": "Kancl — pixel-artový velín nad Claude Code sezeními a projekty",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "npm run build && tsx server/index.ts --open",
    "serve": "tsx server/index.ts",
    "hooks:install": "node hook/install.mjs",
    "hooks:uninstall": "node hook/install.mjs --uninstall",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.*')"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "@types/node": "^22.10.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidskoupy/kancl.git"
  },
  "homepage": "https://github.com/davidskoupy/kancl#readme",
  "keywords": [
    "claude-code",
    "claude",
    "monitor",
    "pixel-art",
    "pixijs",
    "hooks",
    "agents",
    "dashboard",
    "kancl"
  ]
}
